# ==============================================================================
# AgriMandi Flask Backend - Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the /backend directory:
#   cp .env.example .env
#
# DO NOT commit your actual `.env` file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------------------------
# Environment: 'development' or 'production'
ENVIRONMENT=development

# Server port and binding host
PORT=5000
HOST=0.0.0.0

# Set DEBUG=false in production! When true, Flask enables debug reloader.
DEBUG=false

# ------------------------------------------------------------------------------
# 2. Security & Secret Settings
# ------------------------------------------------------------------------------
# Flask application secret key used for session signing and cryptographic ops.
# In production, this MUST be a long random string (e.g. openssl rand -hex 32).
# The backend will fail fast if this is left as default in production.
SECRET_KEY=agrimandi-dev-secret-key-change-in-prod

# (Optional) Supabase JWT secret from Project Settings -> API -> JWT Secret.
# Used if performing server-side cryptographic verification of Supabase tokens.
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------------------
# 3. Database & Supabase Mode
# ------------------------------------------------------------------------------
# USE_MEMORY_DB: Set to 'true' for local offline testing/development without
# connecting to Supabase. All data will be stored in RAM and reset on restart.
# Set to 'false' (default) to connect to live Supabase Postgres database.
# NOTE: USE_MEMORY_DB=true is strictly forbidden in production!
USE_MEMORY_DB=false

# Supabase Project URL (Required when USE_MEMORY_DB=false)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase API Key (Required when USE_MEMORY_DB=false)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys
# Can be the anon (public) key or service_role key for backend operations.
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ------------------------------------------------------------------------------
# 4. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins that can call the API.
# In production on Render/Netlify, set this to your Netlify site URL!
# Example: https://agrimandi.netlify.app,http://localhost:5500
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000


# Server Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=True

# Supabase Database Integration
# Find these credentials in your Supabase Dashboard -> Project Settings -> API
# (Leave blank to run in offline local in-memory fallback mode)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

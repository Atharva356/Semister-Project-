# ==============================================================================
# AgriMandi Flask Backend Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=5000
HOST=0.0.0.0
DEBUG=False

# Explicit in-memory database mode (set to true for offline local dev/tests without Supabase)
USE_MEMORY_DB=false

# Allowed Cross-Origin Resource Sharing (CORS) origins (comma-separated)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
# Required when USE_MEMORY_DB=false
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
